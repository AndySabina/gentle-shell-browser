{
	"manifest_version": 3,
	"name": "Gentle Shell Browser",
	"version": "0.1.0",
	"description": "Lets your Gentle Shell session work in Chrome, only inside its own tab group, with a visible cursor and your approval for risky steps.",
	"minimum_chrome_version": "120",
	"key": "",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "nativeMessaging"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Gentle Shell",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		},
		"default_popup": "popup.html"
	}
}
